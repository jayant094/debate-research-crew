{
  "name": "Review Crew",
  "agents": ["reviewer"],
  "tasks": [
    {
      "name": "review_task",
      "description": "Review and validate the following research report on {topic}:\n\n{research}\n\nFor every material source and claim, compare the summary against the linked source. Flag unsupported claims, broken or mismatched links, outdated evidence, missing context, and unjustified causal conclusions. Assess bias carefully: identify relevant editorial, institutional, funding, selection, or methodological considerations only when they are supported by evidence; otherwise state that bias cannot be determined. Determine whether the source's evidence supports the affirmative/pro side, negative/con side, both, or neither/neutral. Retain percentages and numerical findings exactly as stated in the source, including the applicable population, timeframe, and denominator.",
      "expected_output": "A validated markdown evidence bank with: Fact-Check Summary; Strongest Claims; Weakest or Disputed Claims; and an Evidence Card for each usable source. Each card must include Source title, Publisher, Date (if available), direct URL, summarized claim, exact statistics/percentages with context, reliability rating (High/Medium/Low) and rationale, Bias/limitations assessment with rationale, verification status (Verified/Partially verified/Unverified), and Resolution support (Affirmative/Pro, Negative/Con, Mixed, or Neutral) with a concise explanation. Do not fill gaps with assumptions.",
      "agent": "reviewer",
      "output_file": "output/validated_research.md",
      "markdown": true
    }
  ],
  "process": "sequential",
  "verbose": true,
  "inputs": {
    "topic": "Resolved: The United States federal government should substantially increase its protection of water resources in the United States.",
    "research": ""
  }
}
