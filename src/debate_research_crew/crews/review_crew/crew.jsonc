{
  "name": "Review Crew",
  "agents": ["reviewer"],
  "tasks": [
    {
      "name": "review_task",
      "description": "Audit the following research file for an elite Public Forum round on {topic}:\n\n{research}\n\nApply a zero-tolerance citation review. For every proposed card, verify that its author/institution, date, direct URL, source type, claim, and warrant are present and internally consistent. Classify it as KEEP, QUALIFY, or CUT. CUT any card that depends on a search snippet, lacks a direct source, overstates a study, conflates correlation with causation, treats a projection as observed fact, or uses advocacy/company material outside its proper scope. Identify all definition disputes, plan-text ambiguity, missing internal links, impact-defense holes, and alternative-policy solvency deficits. Preserve the best evidence from both sides; do not manufacture a balance by padding a thin side.",
      "expected_output": "A 3,000-6,000 word validated evidence file with: (1) citation-audit table containing every card's KEEP/QUALIFY/CUT disposition and reason; (2) source-quality tiers and date check; (3) 12-18 fully usable surviving cards, each with tag, evidence, warrant, full citation, direct URL, locator, qualification, and best opposing response; (4) Pro and Con link-chain maps; (5) contested assumptions and forecast uncertainty; (6) top turns, delinks, and impact-defense options; (7) a ranked research gap list; and (8) a cleaned bibliography. Never promote an unsupported claim merely because the supplied report asserted it.",
      "agent": "reviewer",
      "output_file": "output/validated_research.md",
      "markdown": true
    }
  ],
  "process": "sequential",
  "verbose": true,
  "inputs": {
    "topic": "Resolved: The United States federal government should substantially increase its protection of water resources in the United States.",
    "research": ""
  }
}
