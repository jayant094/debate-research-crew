{
  "name": "Research Crew",
  "agents": ["researcher"],
  "tasks": [
    {
      "name": "research_task",
      "description": "Conduct late-elimination-round Public Forum research on {topic}. First define the actor, mandate, scope, duration, enforcement mechanism, and relevant federalism questions. Then research both advocacy positions with a source hierarchy: (1) statutes, regulations, agency reports, congressional research, independent grid operators, national laboratories, and intergovernmental institutions; (2) peer-reviewed research and transparent academic centers; (3) company filings or reports only for company-specific conduct or commitments. Search for disconfirming evidence and alternative policies, not just evidence supporting a moratorium.\n\nBuild 18-24 independently usable evidence cards, balanced across Pro, Con, and shared context. Each card must state: a one-sentence tag; an exact, non-fabricated quotation or a tightly faithful paraphrase clearly labeled as such; author or institution; full title; publication date; direct URL; page, table, figure, or section locator where available; source type; methodology or key limitation; and the precise debate warrant it supports. Include at least four primary/government/technical sources and at least four peer-reviewed or national-laboratory sources. Prefer sources published within the past 24 months, but use older foundational research only when still authoritative. Do not use a search-result snippet as evidence. If the search tool cannot retrieve reliable source material, stop and return a clearly labeled RESEARCH BLOCKED report with the failed tool status and no substitute factual claims.",
      "expected_output": "A 4,000-7,000 word markdown evidence file, not a generic summary. Required sections: (1) Resolution and plan-text ambiguity map; (2) Research methodology and source hierarchy; (3) Evidence cards for Pro; (4) Evidence cards for Con; (5) Cross-applicable context cards; (6) Internal links, turns, and impact comparison; (7) Alternative-policy and solvency research; (8) Forecasting uncertainty and evidentiary limitations; and (9) a complete bibliography. Every card must contain a complete citation and a direct link. Claims without a verifiable source, date, and warrant must be omitted rather than guessed.",
      "agent": "researcher",
      "output_file": "output/research_report.md",
      "markdown": true
    }
  ],
  "process": "sequential",
  "verbose": true,
  "inputs": {
    "topic": "Resolved: The United States federal government should substantially increase its protection of water resources in the United States."
  }
}
